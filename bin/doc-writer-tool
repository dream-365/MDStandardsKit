#!/bin/sh
set -eu

self=$0
while [ -h "$self" ]; do
  d=$(cd -P "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case $self in
    /*) ;;
    *) self=$d/$self ;;
  esac
done

bin=$(cd -P "$(dirname "$self")" && pwd)
_root=$(cd -P "$bin/.." && pwd)
. "$bin/_resolve.sh"

resolve_and_exec "$@"
