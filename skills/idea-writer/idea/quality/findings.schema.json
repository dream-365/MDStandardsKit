{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdstandards:idea-writer:quality:findings.schema:1",
  "title": "Idea quality findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rubric_version",
    "rubric_sha256",
    "target",
    "target_sha256",
    "reviewer",
    "items"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "rubric_version": { "type": "string", "minLength": 1 },
    "rubric_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target": { "type": "string", "minLength": 1 },
    "target_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "model", "session_id", "started_at"],
      "properties": {
        "role": { "const": "independent" },
        "model": { "type": "string" },
        "session_id": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "minLength": 1 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "level", "evidence", "rationale", "missing"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "const": "scored" },
              "level": { "type": "integer", "minimum": 0, "maximum": 2 },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["section", "quote"],
                  "properties": {
                    "section": { "type": "string", "minLength": 1 },
                    "quote": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "rationale": { "type": "string" },
              "missing": { "type": "string" },
              "guess": { "type": "string" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "na_reason"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "const": "na" },
              "na_reason": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  }
}
